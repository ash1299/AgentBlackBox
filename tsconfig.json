{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "controllers",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "noEmitOnError": true,

    "types": ["node"]
  },

  "include": ["controllers/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}